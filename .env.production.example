# Copy thành .env TRÊN VPS rồi điền giá trị thật.
#   cp .env.production.example .env && nano .env
#   docker compose run --rm app php artisan key:generate --show   # lấy APP_KEY

APP_NAME=Kembabies
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kembabies.io.vn

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# DB_HOST là TÊN SERVICE trong compose, không phải 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=order_management
DB_USERNAME=kembabies
DB_PASSWORD=__DOI_MAT_KHAU_NAY__
# chỉ dùng cho container mysql (healthcheck + khởi tạo)
DB_ROOT_PASSWORD=__DOI_MAT_KHAU_NAY__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@kembabies.io.vn"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---- Viettel Post ----
VIETTELPOST_API_URL=https://partner.viettelpost.vn/v2
VIETTELPOST_USERNAME=
VIETTELPOST_PASSWORD=
VIETTELPOST_TOKEN=
VIETTELPOST_SENDER_NAME="Kembabies Clothing"
VIETTELPOST_SENDER_PHONE="0966074330"
VIETTELPOST_SENDER_ADDRESS="22 Cầu Diễn, Bắc Từ Liêm, Hà Nội, Việt Nam"
VIETTELPOST_SENDER_PROVINCE_ID="1"
VIETTELPOST_SENDER_DISTRICT_ID="1"
